<Window x:Class="CSApp.V2w.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSApp.V2w"
        xmlns:vm="clr-namespace:CSApp.V2w.ViewModels"
        mc:Ignorable="d"
        Icon="/Assets/mfra.ico"
        Title="CSApp.V2w"
        Height="1200"
        Width="800"
        WindowState="Maximized"
        ResizeMode="NoResize" >

    <d:Window.DataContext>
        <vm:MainWindowViewModel />
    </d:Window.DataContext>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Center" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
            <Setter Property="Foreground"
                    Value="{Binding MainScreenService.TextColor}" />
        </Style>
    </Window.Resources>

    <Grid RowDefinitions="120 *"
          Background="{Binding MainScreenService.CurrentColor, FallbackValue=#ffaaaa}">
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding DateTime, StringFormat={}{0:dd.MM.yyyy}}"
                           FontSize="35" />
                <TextBlock Text="{Binding DateTime, StringFormat={}{0:HH:mm:ss}}"
                           FontSize="35" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock Text="{Binding MainScreenService.CurrentText, FallbackValue=Hello hello hello hello hello}"
                       FontSize="70" />
        </Grid>
    </Grid>
</Window>
